---
interface Props {
  slotId: string;
  format?: 'auto' | 'fluid' | 'rectangle';
}
const { slotId, format = 'auto' } = Astro.props;
---
<div class="my-8 flex flex-col items-center justify-center min-h-[260px] bg-slate-900/30 border border-slate-800 rounded-lg p-2">
  <span class="text-[10px] uppercase tracking-widest text-slate-500 mb-1">Advertisement</span>
  <ins class="adsbygoogle w-full"
       style="display:block"
       data-ad-client="ca-pub-XXXXXXXXXXXXXXXX"
       data-ad-slot={slotId}
       data-ad-format={format}
       data-full-width-responsive="true"></ins>
  <script is:inline>
    (adsbygoogle = window.adsbygoogle || []).push({});
  </script>
</div>