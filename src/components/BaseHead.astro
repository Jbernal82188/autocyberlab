---
interface Props {
  title: string;
  description: string;
  lang: 'es' | 'en';
  translationSlug?: string;
}

const { title, description, lang, translationSlug } = Astro.props;
const siteUrl = Astro.site || 'https://autocyberlab.com';
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const alternateLang = lang === 'es' ? 'en' : 'es';
const alternateURL = translationSlug 
  ? new URL(`/${alternateLang}/${translationSlug}/`, siteUrl)
  : new URL(`/${alternateLang}/`, siteUrl);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{title} | AutoCyberLab</title>
<meta name="description" content={description} />
<meta name="application-name" content="AutoCyberLab" />
<meta property="og:site_name" content="AutoCyberLab" />
<link rel="canonical" href={canonicalURL} />

<!-- Favicon para el Buscador de Google y Pestañas -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="shortcut icon" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/favicon.svg" />

<!-- SEO Internacional Hreflang -->
<link rel="alternate" hreflang={lang} href={canonicalURL} />
<link rel="alternate" hreflang={alternateLang} href={alternateURL} />
<link rel="alternate" hreflang="x-default" href={lang === 'en' ? canonicalURL : alternateURL} />

<!-- Datos Estructurados para que Google muestre el nombre "AutoCyberLab" arriba de la URL -->
<script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "AutoCyberLab",
    "alternateName": ["ACL", "AutoCyberLab.com"],
    "url": "https://autocyberlab.com/"
  }
</script>