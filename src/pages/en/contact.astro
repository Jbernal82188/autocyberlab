---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
---
<html lang="en" class="dark">
  <head>
    <BaseHead title="Contact Us" description="Contact the AutoCyberLab engineering team for technical inquiries or partnerships." lang="en" translationSlug="contacto" />
  </head>
  <body class="bg-[#0A0D12] text-neutral-200 min-h-screen flex flex-col font-sans">
    <Header lang="en" alternateUrl="/es/contacto/" />
    <main class="max-w-2xl mx-auto px-4 py-16 flex-grow w-full">
      <span class="bg-[#00D36C] text-black text-xs font-black font-mono uppercase tracking-widest px-3 py-1">
        DIRECT CHANNEL
      </span>
      <h1 class="text-4xl font-black text-white mt-4 mb-4">Contact AutoCyber<span class="text-[#00D36C]">Lab</span></h1>
      <p class="text-neutral-400 mb-8">Have a technical question about OBD2 diagnostics, CAN Bus security, or commercial partnerships? Send us a message below.</p>
      
      <form action="https://api.web3forms.com/submit" method="POST" class="space-y-5 bg-[#11161F] p-8 border border-neutral-800">
        <input type="hidden" name="access_key" value="c9e3498e-3b97-40e6-a49e-d215505698f1" />
        <div>
          <label class="block text-xs font-mono uppercase text-[#00D36C] mb-2">Name</label>
          <input type="text" name="name" required class="w-full bg-black border border-neutral-800 px-4 py-3 text-white focus:border-[#00D36C] outline-none" />
        </div>
        <div>
          <label class="block text-xs font-mono uppercase text-[#00D36C] mb-2">Email Address</label>
          <input type="email" name="email" required class="w-full bg-black border border-neutral-800 px-4 py-3 text-white focus:border-[#00D36C] outline-none" />
        </div>
        <div>
          <label class="block text-xs font-mono uppercase text-[#00D36C] mb-2">Message</label>
          <textarea name="message" rows="4" required class="w-full bg-black border border-neutral-800 px-4 py-3 text-white focus:border-[#00D36C] outline-none"></textarea>
        </div>
        <button type="submit" class="bg-[#00D36C] text-black font-black uppercase tracking-wider px-6 py-3 hover:bg-white transition w-full">
          Send Message
        </button>
      </form>
    </main>
  </body>
</html>
